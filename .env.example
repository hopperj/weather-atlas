# Web gateway ports (HTTP redirects only; all app/API content requires HTTPS).
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
HTTPS_PORT=8443
# One public DNS hostname only: no scheme, port, or comma-separated HTTP site.
# Configure DNS and inbound routing for the server hosting this name.
# Public TCP 80/443 must reach APP_PORT/HTTPS_PORT (or use host ports 80/443).
# See docs/https.md. Do not use :80 or a LAN hostname as the site address.
CADDY_SITE_ADDRESS=weatheratlas.ioresearch.ca
AIRFLOW_PORT=8081

# PostgreSQL bootstrap credentials (development defaults; change in production).
# These values are embedded in connection URLs; use URL-safe random values such
# as `openssl rand -hex 32`, or percent-encode reserved URL characters.
POSTGRES_ADMIN_PASSWORD=change-me-postgres
POSTGRES_HOST_PORT=5433
POSTGRES_IMAGE=weather-platform-postgis:18-3.6
POSTGRES_BASE_IMAGE=postgres:18.4-alpine3.23
REDIS_IMAGE=redis:7.4-alpine
AIRFLOW_DB_PASSWORD=change-me-airflow-db
WEATHER_APP_DATABASE=weather_app
WEATHER_MIGRATOR_USER=weather_migrator
WEATHER_MIGRATOR_PASSWORD=change-me-weather-migrator

# Least-privilege application service credentials
WEATHER_API_PASSWORD=change-me-weather-api
WEATHER_TILES_PASSWORD=change-me-weather-tiles
WEATHER_INGEST_PASSWORD=change-me-weather-ingest
WEATHER_READONLY_PASSWORD=change-me-weather-readonly
WEATHER_BACKUP_PASSWORD=change-me-weather-backup
REDIS_URL=redis://redis:6379/0

# Opaque raster-layer tokens shared only by the weather and tile APIs.
# Generate with: openssl rand -hex 32
WEATHER_LAYER_TOKEN_SECRET=change-me-layer-token-secret-at-least-32-characters
WEATHER_LAYER_TOKEN_TTL_SECONDS=86400
WEATHER_SAMPLE_CACHE_TTL_SECONDS=300
WEATHER_SAMPLE_RATE_LIMIT_PER_MINUTE=120

# Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-airflow-jwt

# NOAA GFS archive for FLEXPART. The default stores complete global 1-degree
# pressure-grid files for analysis through +24 h every three hours.
GFS_RESOLUTION=1p00
GFS_FORECAST_HOURS=0,3,6,9,12,15,18,21,24
GFS_LOOKBACK_HOURS=18
GFS_MAXIMUM_CYCLES_PER_RUN=2
GFS_MINIMUM_FREE_BYTES=53687091200
GFS_MAXIMUM_DOWNLOAD_BYTES=2147483648
GFS_TIMEOUT_SECONDS=240

# NRCan CWFIS Fire M3 daily VIIRS hotspot archive and GeoJSON snapshots.
CWFIS_LAG_DAYS=1
CWFIS_LOOKBACK_DAYS=7
CWFIS_MAXIMUM_DAYS_PER_RUN=3
CWFIS_MAXIMUM_ROWS=500000
CWFIS_MINIMUM_FREE_BYTES=5368709120
CWFIS_MAXIMUM_DOWNLOAD_BYTES=104857600
CWFIS_TIMEOUT_SECONDS=180
CWFIS_CFFDRS_LAG_DAYS=1
CWFIS_CFFDRS_LOOKBACK_DAYS=4
CWFIS_CFFDRS_MAXIMUM_DAYS_PER_RUN=3
CWFIS_CFFDRS_MINIMUM_FREE_BYTES=5368709120
CWFIS_CFFDRS_MAXIMUM_GRID_BYTES=134217728
CWFIS_CFFDRS_TIMEOUT_SECONDS=300

# Smoke simulations remain read-only until local scientific validation is approved.
SIMULATION_WRITES_ENABLED=false
SMOKE_VALIDATION_RUNS_ENABLED=false
SMOKE_OPERATIONAL_ENABLED=false
SMOKE_CFFEPS_EXECUTABLE=/opt/weather/bin/weatherapp-cffeps
SMOKE_FLEXPART_ROOT=/opt/weather/flexpart
SMOKE_FLEXPART_EXECUTABLE=/opt/weather/bin/FLEXPART
SMOKE_FLEXPART_THREADS=8
SMOKE_PARTICLE_BUDGET=250000
SMOKE_MAX_HORIZON_HOURS=24
SMOKE_MAX_DOMAIN_CELLS=50000
SMOKE_MAXIMUM_PARTICLES=1000000
SMOKE_MAXIMUM_RELEASES=20000
SMOKE_MAX_QUEUED_RUNS=5
SMOKE_RUN_TIMEOUT_SECONDS=10800
SMOKE_MAXIMUM_OUTPUT_BYTES=21474836480
SMOKE_MINIMUM_FREE_BYTES=21474836480
SMOKE_MAXIMUM_STORAGE_BYTES=549755813888
SMOKE_INTERACTIVE_RETENTION_DAYS=30
SMOKE_OPERATIONAL_RETENTION_DAYS=14

# All mutable container data lives below this host directory.
WEATHERAPP_DATA_DIR=./weatherapp_data
WEATHER_DATA_DIR=./weatherapp_data/weather
WEATHER_BACKUP_DIR=./weatherapp_data/backups/postgres
STORAGE_INIT_IMAGE=alpine:3.22

# Optional: docker compose --profile observability up -d
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_IMAGE=grafana/grafana:13.1.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
