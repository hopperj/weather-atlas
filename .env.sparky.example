# Non-secret standby settings for sparky. Merge into the existing private .env;
# this is NOT a complete replacement for credentials or application settings.
# PostgreSQL stays on sparky's local SSD.
POSTGRES_DATA_DIR=/home/hopperj/weather-atlas/postgres_data
# Ordinary service files use the NAS; monitoring databases stay local.
WEATHERAPP_DATA_DIR=/home/hopperj/weather-atlas/data/services
WEATHER_BACKUP_DIR=/home/hopperj/weather-atlas/data/services/backups/postgres
WEATHER_MONITORING_DIR=/home/hopperj/weather-atlas/postgres_data/monitoring
WEATHER_MANAGE_SERVICE_PERMISSIONS=false
REDIS_RUN_USER=999:1000

# The NAS is mounted as data; its weather/ child contains raw/processed/etc.
WEATHER_DATA_DIR=/home/hopperj/weather-atlas/data/weather
WEATHER_DATA_MOUNTPOINT=/home/hopperj/weather-atlas/data
WEATHER_DATA_MOUNT_SOURCE=databanks.iolan:/volume1/data/weather-atlas-data
WEATHER_MANAGE_DATA_PERMISSIONS=false
WEATHER_DATA_GID=100
AIRFLOW_UID=1000
WEATHER_MIN_FREE_GIB=200
WEATHER_MIN_FREE_PERCENT=0
# Set ECCC_SUBSCRIBER_HOSTNAME to the outgoing subscriber's Config.Hostname
# during handover, preserving its broker queue. Do not run both collectors.

# Read-only API testing until the coordinated production cutover.
SIMULATION_WRITES_ENABLED=false
SMOKE_VALIDATION_RUNS_ENABLED=false

# Retain until permissions, final sync, restore and cutover checks pass.
WEATHER_STARTUP_HOLD=NAS-subfolder-permissions-and-final-cutover-pending
